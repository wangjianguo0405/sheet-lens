{
  "name": "sheet-lens",
  "private": true,
  "version": "1.0.22",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\" eslint.config.js .prettierrc.json",
    "fmt:check": "prettier --check \"src/**/*.{ts,tsx,css}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check && eslint .",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-resizable-panels": "4.14.2",
    "shadcn": "4.21.3",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.3"
  }
}
