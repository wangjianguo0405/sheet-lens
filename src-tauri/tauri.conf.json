{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SheetLens",
  "version": "1.0.14",
  "identifier": "com.sheetlens.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SheetLens",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "maximized": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wangjianguo0405/sheet-lens/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTMyRkQ2QTREN0VDMkYKUldRdjdOZWsxaThUdkN5VEE2ZnZvYXJFekdYRTdCMUVqOTVXd3RTOXJVckxNOW5BQ0RBTmphalYK",
      "requireSignedVersion": true
    }
  }
}
